# ============================================================
# SpendStory Environment Configuration
# ============================================================

# Database Connection URL:
# For local SQLite development (default):
# DATABASE_URL=sqlite:///./expenses.db

# For Production (PostgreSQL on Supabase, Render, Neon, RDS, etc.):
# DATABASE_URL=postgresql://postgres:your_password@db.your-host.com:5432/spendstory

# CORS Allowed Origins (comma-separated):
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-frontend-domain.com

# Session Security:
SESSION_DURATION_DAYS=30

# Database Connection Pool (PostgreSQL):
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

